# systemd unit — HotPod pageserver on a bare VM / host
# Install:
#   sudo cp deploy/systemd/hotpod-pageserver.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   echo "your-long-random-token" | sudo tee /etc/hotpod/token   # chmod 600
#   sudo systemctl enable --now hotpod-pageserver
# Logs:   journalctl -u hotpod-pageserver -f
# Status: systemctl status hotpod-pageserver   (stats printed on stop)

[Unit]
Description=HotPod pageserver (lazy migration page source)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=hotpod
Group=hotpod
# userfaultfd for unprivileged users (kernel >= 5.11); or run as root with
# CAP_SYS_PTRACE instead if you prefer not to touch the sysctl.
ExecStartPre=/sbin/sysctl -w vm.unprivileged_userfaultfd=1
ExecStart=/usr/local/bin/pageserver \
  --port 46100 \
  --image /var/lib/hotpod/app.isim \
  --token-file /etc/hotpod/token
Environment=HOTPOD_TOKEN_FILE=/etc/hotpod/token
Restart=on-failure
RestartSec=2
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/hotpod

[Install]
WantedBy=multi-user.target
